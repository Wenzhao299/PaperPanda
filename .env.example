# ============================================================
# PaperPanda 环境配置文件
# 复制此文件为 .env 并填写实际值
# ============================================================

# ---- 应用基础配置 ----
APP_NAME=PaperPanda
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-this-in-production
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=paperpanda
POSTGRES_PASSWORD=paperpanda_secret
POSTGRES_DB=paperpanda
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# ---- Milvus ----
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=

# ---- Meilisearch ----
MEILISEARCH_HOST=http://localhost
MEILISEARCH_PORT=7700
MEILISEARCH_API_KEY=paperpanda_meili_key

# ---- JWT 认证 ----
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- 邮件 SMTP ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=PaperPanda
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=true

# ---- LLM 服务 - OpenAI 兼容 ----
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- LLM 服务 - DeepSeek (OpenAI 兼容) ----
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---- LLM 服务 - Qwen (OpenAI 兼容) ----
QWEN_API_KEY=sk-your-qwen-api-key
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ---- LLM 服务 - Google Gemini ----
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# ---- LLM 服务 - Anthropic ----
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ---- 默认 LLM Provider ----
# 可选: openai, deepseek, qwen, gemini, anthropic
DEFAULT_LLM_PROVIDER=deepseek
DEFAULT_CHAT_MODEL=deepseek-chat
NON_CHAT_LOCAL_ONLY=true
DEFAULT_TRANSLATE_PROVIDER=local_qwen
DEFAULT_TRANSLATE_MODEL=deepseek-chat
DEFAULT_SUMMARIZE_PROVIDER=local_llama
DEFAULT_SUMMARIZE_MODEL=deepseek-chat
DEFAULT_RERANK_MODEL=deepseek-chat
RERANK_ENABLE_LLM=false
RERANK_LLM_PROVIDERS=local_qwen,local_llama
RERANK_LLM_TOP_K=24
RERANK_RECALL_TOP_K=120
RERANK_RRF_K=60
RERANK_SEMANTIC_WEIGHT=0.7
RERANK_KEYWORD_WEIGHT=0.3
# 本地 LLM（用于重排，避免 API 429）
LOCAL_QWEN_MODEL_PATH=
LOCAL_LLAMA_MODEL_PATH=
LOCAL_9G4B_MODEL_PATH=
# 多卡建议：按服务拆分到不同 GPU，例如 cuda:0/1/2
LOCAL_QWEN_DEVICE=auto
LOCAL_LLAMA_DEVICE=auto
LOCAL_9G4B_DEVICE=auto
LOCAL_LLM_DEVICE=auto
LOCAL_LLM_MAX_NEW_TOKENS=256
LOCAL_LLM_TEMPERATURE=0.0

# ---- Embedding 配置 ----
# 可选: local_bge, local_qwen, openai, gemini
EMBEDDING_PROVIDER=local_bge
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_LOCAL_MODEL_PATH=
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cuda:0
# 远程 Embedding API（当 EMBEDDING_PROVIDER 为 openai/gemini 时使用）
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ---- 知识库 PDF 管道 ----
UPLOAD_STORAGE_DIR=data/uploads
UPLOAD_MAX_FILE_SIZE_MB=30
KNOWLEDGE_CHUNK_SIZE=512
KNOWLEDGE_CHUNK_OVERLAP=64
KNOWLEDGE_CHAT_CONTEXT_CHARS=1200

# ---- arXiv 爬虫配置 ----
ARXIV_CATEGORIES=cs.AI,cs.CL,cs.CV,cs.LG,cs.IR
ARXIV_CRAWL_INTERVAL_HOURS=24
ARXIV_BATCH_SIZE=100
ARXIV_MAX_RESULTS_PER_CATEGORY=1000
ARXIV_INCREMENTAL_OVERLAP_DAYS=2
PIPELINE_TRANSLATE_BATCH_SIZE=200
PIPELINE_TRANSLATE_CONCURRENCY=2
PIPELINE_TRANSLATE_TARGET_LANG=zh

# ---- CCF 论文爬虫配置 ----
CCF_YEAR_FROM=2020
CCF_YEAR_TO=2026
CCF_DOMAINS=security,graphics,ai
# 请求节流/重试（可选，遇到 DBLP 429 时调大）
CCF_REQUEST_MAX_RETRIES=5
CCF_REQUEST_BACKOFF_SEC=1.0
CCF_VENUE_DELAY_SEC=0.35
CCF_DETAIL_FETCH_CONCURRENCY=4
CCF_DETAIL_BATCH_SIZE=120
CCF_MAX_DETAIL_URLS=2

# ---- Celery ----
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/2

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- 日志 ----
LOG_LEVEL=INFO
LOG_FORMAT=json
